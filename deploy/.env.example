# Copy to deploy/.env on the VM and fill in. Never commit the filled-in file.

# Public hostname whose DNS A/AAAA record points at this VM. Caddy issues its HTTPS
# certificate automatically. Without a domain, <ip-with-dashes>.sslip.io works.
DOMAIN=office.example.com

# Generate each with: openssl rand -hex 32
POSTGRES_PASSWORD=
SESSION_SECRET=

AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
ELEVENLABS_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5.6-luna
EMPTY_ROOM_GRACE_MS=10000

# Optional: creates the first administrator when the database has no users.
# Remove the password after the account exists.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Administrator
