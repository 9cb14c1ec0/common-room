{
  "name": "office-hours",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"npm run dev -w @office/web\" \"npm run dev -w @office/api\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "start:api": "npm run start -w @office/api",
    "start:worker": "npm run start -w @office/worker",
    "dev:desktop": "npm run dev -w @office/desktop",
    "dist:desktop": "npm run dist -w @office/desktop"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "^5.9.2"
  },
  "engines": { "node": ">=22" }
}
